# Aiven MySQL Overview 페이지의 "Service URI" 값을 그대로 붙여넣으면 됩니다.
# 예: mysql://avnadmin:비밀번호@호스트:포트/defaultdb
MYSQL_URL=

# Aiven은 SSL 접속이 기본입니다. 로컬의 SSL 없는 MySQL/MariaDB에 붙일 때만 false로 바꾸세요.
DB_SSL=true

# MYSQL_URL이 없을 때만 아래 개별 값을 사용합니다 (로컬 개발용)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pds_diary

PORT=3000

# ---------- 과제 7: 인증 ----------
# 아래 두 값은 반드시 서로 다른, 추측하기 어려운 임의의 긴 문자열로 채워 넣으세요.
# (예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" 로 생성)
# 절대 Git에 올리지 마세요 — 이 파일은 예시일 뿐이고 실제 값은 .env 에만 넣습니다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 액세스 토큰 만료(짧게), 리프레시 토큰 만료(길게, 일 단위)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Render 등 프로덕션 배포에서는 NODE_ENV=production 으로 설정해야
# 리프레시 쿠키의 secure 옵션이 켜집니다(HTTPS에서만 쿠키 전송).
NODE_ENV=development

# 프론트를 다른 도메인에서 서빙한다면 그 주소를 적어주세요. 같은 도메인에서 서빙 중이면 비워둬도 됩니다.
CORS_ORIGIN=
